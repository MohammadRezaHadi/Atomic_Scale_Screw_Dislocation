# FCC Aluminum – 1/2<110> Screw Dislocation
# Energy Minimization + Force Evaluation
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# Read structure from Atomsk
read_data       Al_screw_single.lmp
#read_data       Al_screw_dipole.lmp
#read_data       Al_screw_quadrupole.lmp

# Interatomic Potential (EAM and MEAM)
#pair_style      eam/alloy
#pair_coeff      * * Al99.eam.alloy Al

#pair_style      eam/alloy
#pair_coeff      * * Zope-Ti-Al-2003.eam.alloy Al

#pair_style      eam/alloy
#pair_coeff     * * Al-LEA.eam.alloy Al

pair_style      meam
pair_coeff      * * library.meam Al Al.meam Al

# Neighbor Settings
neighbor        2.0 bin
neigh_modify    delay 10 check yes

# Computes (for OVITO analysis)
compute         csym all centro/atom fcc
compute         peatom all pe/atom
compute         stress all stress/atom NULL

# Thermodynamic Output
thermo          10
thermo_style    custom step pe lx ly lz press pxx pyy pzz

# Energy Minimization
reset_timestep  0

min_style       cg
minimize        1.0e-25 1.0e-25 10000 10000

# Output relaxed configuration
write_data      Al_screw_single_relaxed.lmp
#write_data      Al_screw_dipole_relaxed.lmp
#write_data      Al_screw_quadrupole_relaxed.lmp

# Dump forces after relaxation
dump            1 all custom 1 dump.screw_single_force id type x y z fx fy fz c_csym c_peatom c_stress[1] c_stress[2] c_stress[3] c_stress[4] c_stress[5] c_stress[6]
#dump            1 all custom 1 dump.screw_dipole_force id type x y z fx fy fz c_csym c_peatom c_stress[1] c_stress[2] c_stress[3] c_stress[4] c_stress[5] c_stress[6]
#dump            1 all custom 1 dump.screw_quadrupole_force id type x y z fx fy fz c_csym c_peatom c_stress[1] c_stress[2] c_stress[3] c_stress[4] c_stress[5] c_stress[6]
dump_modify     1 sort id

run             0

print "Minimization complete."
